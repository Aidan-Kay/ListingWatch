{
  "name": "listing-watch",
  "version": "1.1.0",
  "description": "ListingWatch — multi-site listing monitor",
  "main": "src/main/main.js",
  "scripts": {
    "start": "npx tailwindcss -i ./src/renderer/styles/input.css -o ./src/renderer/styles/style.css && npx electron .",
    "dev": "npx electron .",
    "build:css": "npx tailwindcss -i ./src/renderer/styles/input.css -o ./src/renderer/styles/style.css --minify",
    "build:win": "npm run build:css && npx electron-builder --win --publish never",
    "build:linux": "npm run build:css && npx electron-builder --linux --publish never",
    "build:all": "npm run build:css && npx electron-builder --publish never",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.3"
  },
  "build": {
    "appId": "com.listingwatch.app",
    "productName": "ListingWatch",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
